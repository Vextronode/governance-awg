{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Vextronode/governance-awg/catalog/schema/status.schema.json",
  "title": "AWG v2 docs/awg/status.yaml",
  "description": "Status per kontrol (RFC-0001 M.3, C.4) dan blok verifikasi (E.2). Syarat C.4 yang bisa diungkapkan per entri ada di if/then di bawah. Aturan lintas file (cakupan kontrol berlaku, ID asing, waiver aktif, independensi verifikator, verifikasi ganda critical, larangan not_applicable untuk BASE) ditegakkan di tools/awg-validate. RFC-0002: role self_review/external_reviewer dan field opsional implemented_at; aturan yang bergantung pada mode tata kelola (S-1 s.d. S-7, implemented_at wajib di solo) ditegakkan di tools/awg-validate.",
  "type": "object",
  "properties": {
    "awg_version": { "type": "string", "pattern": "^v\\d+\\.\\d+\\.\\d+$" },
    "system": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*$" },
    "controls": { "type": "array", "items": { "$ref": "#/$defs/entry" } }
  },
  "required": ["awg_version", "system", "controls"],
  "additionalProperties": false,
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "evidenceItem": {
      "type": "object",
      "properties": {
        "type": { "enum": ["code", "config", "test", "ci_run", "document", "screenshot", "report"] },
        "ref": { "type": "string" },
        "note": { "type": "string" }
      },
      "required": ["type", "ref"],
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "properties": {
        "verifier": { "$ref": "#/$defs/nonEmpty" },
        "verifier_role": {
          "enum": ["rotation", "devops_coordinator", "qa_coordinator", "program_coordinator", "self_review", "external_reviewer"]
        },
        "verifier_system": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*$" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "result": { "enum": ["verified", "rejected"] },
        "note": { "type": "string" }
      },
      "required": ["verifier", "verifier_role", "verifier_system", "date", "result", "note"],
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^(BASE|MOD|SYS)-[A-Z][A-Z0-9-]*-\\d{3}$" },
        "status": { "enum": ["not_started", "in_progress", "implemented", "verified", "rejected", "waived", "not_applicable"] },
        "implemented_at": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "owner": { "type": "string" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidenceItem" } },
        "waiver": { "type": ["string", "null"] },
        "reason": { "type": ["string", "null"] },
        "verification": { "type": "array", "items": { "$ref": "#/$defs/verification" } },
        "notes": { "type": "string" }
      },
      "required": ["id", "status", "owner", "evidence", "waiver", "reason", "verification", "notes"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "in_progress" } } },
          "then": { "properties": { "owner": { "$ref": "#/$defs/nonEmpty" } } }
        },
        {
          "if": { "properties": { "status": { "enum": ["implemented", "verified"] } } },
          "then": {
            "properties": {
              "evidence": {
                "minItems": 1,
                "contains": { "properties": { "ref": { "$ref": "#/$defs/nonEmpty" } } }
              }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "verified" } } },
          "then": {
            "properties": {
              "verification": { "minItems": 1, "contains": { "properties": { "result": { "const": "verified" } } } }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "rejected" } } },
          "then": {
            "properties": {
              "verification": {
                "minItems": 1,
                "contains": { "properties": { "result": { "const": "rejected" }, "note": { "$ref": "#/$defs/nonEmpty" } } }
              }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "waived" } } },
          "then": { "properties": { "waiver": { "$ref": "#/$defs/nonEmpty" } } }
        },
        {
          "if": { "properties": { "status": { "const": "not_applicable" } } },
          "then": {
            "properties": {
              "reason": { "$ref": "#/$defs/nonEmpty" },
              "verification": { "minItems": 1, "contains": { "properties": { "result": { "const": "verified" } } } }
            }
          }
        }
      ]
    }
  }
}

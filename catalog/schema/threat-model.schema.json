{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Vextronode/governance-awg/catalog/schema/threat-model.schema.json",
  "title": "AWG v2 docs/awg/threat-model.yaml",
  "description": "Berbasis schema v1 AWG-SEC-003 dengan perubahan RFC-0001 M.6 dan skala F.3. Aturan lintas field (score = likelihood x impact, rating sesuai F.3, setiap trust boundary punya finding, done butuh verification_evidence) ditegakkan di tools/awg-validate.",
  "type": "object",
  "properties": {
    "awg_version": { "type": "string" },
    "system_info": {
      "type": "object",
      "properties": {
        "system_name": { "type": "string" },
        "tech_lead": { "type": "string" },
        "last_updated": { "type": "string" },
        "program_gate_at_submission": { "type": "string" }
      },
      "required": ["system_name", "tech_lead", "last_updated", "program_gate_at_submission"],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "reviewer": { "type": "string" },
        "date": { "type": "string", "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$" },
        "note": { "type": "string" }
      },
      "required": ["reviewer", "date", "note"],
      "additionalProperties": false
    },
    "dfd_elements": {
      "type": "object",
      "properties": {
        "external_entities": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "trust_level": { "type": "string" }
            },
            "required": ["name"],
            "additionalProperties": false
          }
        },
        "processes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "data_classification_touched": { "type": "array", "items": { "type": "string" } }
            },
            "required": ["name"],
            "additionalProperties": false
          }
        },
        "data_stores": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "data_classification": { "type": "string" }
            },
            "required": ["name"],
            "additionalProperties": false
          }
        },
        "data_flows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "source": { "type": "string" },
              "destination": { "type": "string" },
              "data_classification": { "type": "string" },
              "crosses_trust_boundary": { "type": "boolean" }
            },
            "required": ["name"],
            "additionalProperties": false
          }
        }
      },
      "required": ["external_entities", "processes", "data_stores", "data_flows"],
      "additionalProperties": false
    },
    "trust_boundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "boundary_id": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "elements_involved": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["boundary_id", "description", "elements_involved"],
        "additionalProperties": false
      }
    },
    "stride_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding_id": { "type": "string", "minLength": 1 },
          "element": { "type": "string" },
          "trust_boundary_ref": { "type": "string" },
          "stride_category": {
            "enum": ["Spoofing", "Tampering", "Repudiation", "Information Disclosure", "Denial of Service", "Elevation of Privilege"]
          },
          "threat_description": { "type": "string", "minLength": 1 },
          "likelihood": { "type": "integer", "minimum": 1, "maximum": 3 },
          "impact": { "type": "integer", "minimum": 1, "maximum": 3 },
          "score": { "enum": [1, 2, 3, 4, 6, 9] },
          "risk_rating": { "enum": ["low", "medium", "high", "critical"] },
          "related_controls": {
            "type": "array",
            "items": { "type": "string", "pattern": "^(BASE|MOD|SYS)-[A-Z][A-Z0-9-]*-\\d{3}$" }
          },
          "mitigation": { "type": "string" },
          "mitigation_status": { "enum": ["not_started", "in_progress", "done"] },
          "owner": { "type": "string" },
          "verification_evidence": { "type": "string" },
          "source": { "enum": ["team", "claude-draft"] }
        },
        "required": [
          "finding_id", "element", "trust_boundary_ref", "stride_category", "threat_description", "likelihood",
          "impact", "score", "risk_rating", "related_controls", "mitigation", "mitigation_status", "owner",
          "verification_evidence", "source"
        ],
        "additionalProperties": false,
        "anyOf": [
          { "properties": { "related_controls": { "minItems": 1 } } },
          { "properties": { "mitigation": { "minLength": 1 } } }
        ]
      }
    },
    "submission_checklist": { "type": "object", "additionalProperties": { "type": "boolean" } }
  },
  "required": ["system_info", "review", "dfd_elements", "trust_boundaries", "stride_findings"],
  "additionalProperties": false
}
